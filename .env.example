# Copy this to .env in the root folder and fill in your own values.
# Never commit a filled-in .env with real keys.
# YouTube: YOUTUBE_API_KEY is the name used in Vercel; YOUTUBE_DATA_API also works.
YOUTUBE_API_KEY=
YOUTUBE_DATA_API=
GROQ_API_KEY=
# Google sign-in is ENABLED when GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET are set.
# Set AUTH_ENABLED=false only to turn it off again. Leave GOOGLE_REDIRECT_URI
# unset in Vercel to use https://<your-domain>/auth/google/callback automatically
# (that exact URI must be registered in the Google Cloud OAuth client).
AUTH_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Default admin — reserved for a future admin account. Names only here:
# never put a real admin password in this file or in the repo.
# Set ADMIN_PASSWORD only as a Vercel env var, and make it strong.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
PORT=3000
