# My Music — fill these in locally. Do NOT commit real values.
# This file lives in the root folder. It is gitignored (see .gitignore),
# so a real filled-in copy stays on your machine only.
# For deployment (for example Vercel), set the same names as environment variables.
YOUTUBE_DATA_API=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
